# Dependencias de Node.js
node_modules/
backend/node_modules/

# Archivos de entorno (¡MUY IMPORTANTE!)
.env
backend/.env
SENSIBLE.md

# Archivos de configuración con credenciales (¡NO COMITEAR!)
frontend/config.js

# Archivos locales con credenciales (¡NO COMITEAR!)
*.local
MERCADOPAGO_SANDBOX_CREDENTIALS.local
LOCAL_CREDENTIALS.md

# Backups y archivos de migración (no subirlos al repositorio)
_backups/

# Binary Logs de MariaDB (recovery estrategy - punto en tiempo)
docker/binlogs/
mariadb_binlogs/
*.binlog
mariadb-bin.*
# Logs y archivos temporales
*.log
npm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db

contexto_negocio.md
uploads/
backend/uploads/
gemini-env/

# Backups comprimidos (archivos de respaldo)
*.tar.gz
tdcApiRest_backup_*.tar.gz
_backups/*.tar.gz
# Volumen de Chromium (datos de sesión, cookies, historiales)
